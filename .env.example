# =============================================================================
# Multi-Agent AI Analyst - environment template
# -----------------------------------------------------------------------------
# 1. Copy this file:   cp .env.example .env      (Windows: copy .env.example .env)
# 2. Fill in YOUR OWN keys. Never commit .env - it is git-ignored.
# 3. Only GOOGLE_API_KEY is REQUIRED. Everything else degrades gracefully.
# =============================================================================

# --- PROVIDER SELECTION -------------------------------------------------------
# gemini   (default) free, no credit card. Covers chat AND embeddings.
# openai              paid. One OPENAI_API_KEY covers chat AND embeddings.
# deepseek            chat only - always pair it with a Gemini or OpenAI key
#                     for embeddings, since DeepSeek ships no embedding model.
LLM_PROVIDER=gemini
LLM_TEMPERATURE=0

# --- Gemini (required unless you switch provider AND embeddings) --------------
# Free, no credit card: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=models/gemini-embedding-001

# --- OpenAI (used when LLM_PROVIDER=openai or EMBED_PROVIDER=openai) ---------
# https://platform.openai.com/api-keys  - NOTE: paid, requires a payment method.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
# Optional: a proxy or OpenAI-compatible gateway. Leave blank for api.openai.com.
OPENAI_BASE_URL=

# --- DeepSeek (optional, chat only) -------------------------------------------
# https://platform.deepseek.com   (set LLM_PROVIDER=deepseek to use it)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Embeddings ---------------------------------------------------------------
# Blank = auto: follows LLM_PROVIDER when that provider has embeddings,
# otherwise falls back to whichever key is present (Gemini first - it is free).
# Force with `gemini` or `openai`, e.g. to run OpenAI chat + free Gemini vectors.
EMBED_PROVIDER=
# Both models truncate to this dimension (Matryoshka). 768 keeps the vector
# store small and fast; the collection is created to match automatically.
# WARNING: changing EMBED_PROVIDER or EMBED_DIM invalidates an existing
# collection. Re-ingest with:  python -m ingestion.ingest --reset
EMBED_DIM=768

# --- OPTIONAL: web search (F4). Unset => web agent skips cleanly --------------
# Free 1,000 searches/month: https://tavily.com
TAVILY_API_KEY=

# --- Vector store (F2). Embedded local mode = no signup, no server ------------
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=analyst_docs
QDRANT_MEMORY_COLLECTION=analyst_memory
# OPTIONAL cloud fallback (https://cloud.qdrant.io, free 1GB).
# If QDRANT_URL is set it takes priority over QDRANT_PATH.
QDRANT_URL=
QDRANT_API_KEY=

# --- Data agent (F5) ----------------------------------------------------------
SQLITE_PATH=./data/company.db

# --- Code agent sandbox (F6) --------------------------------------------------
CODE_TIMEOUT_SECONDS=15
CODE_MEMORY_LIMIT_MB=512

# --- Graph safety rails (F9) --------------------------------------------------
RECURSION_LIMIT=25
MAX_REVISIONS=2
RETRIEVER_TOP_K=4
MEMORY_TOP_K=3

# --- OPTIONAL: observability (F12). Unset => tracing disabled, no crash -------
# Free tier: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- API server (F13/F14) -----------------------------------------------------
PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Docker / Render only -----------------------------------------------------
# Embed the document corpus on container boot. Set true on the FIRST deploy,
# then back to false - otherwise every restart re-embeds and burns quota.
AUTO_INGEST=false
WEB_CONCURRENCY=1
