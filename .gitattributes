# Normalise line endings.
#
# The critical line is the *.sh one. On Windows, git checks shell scripts out
# with CRLF by default; Docker then copies `docker-entrypoint.sh` into a Linux
# image where the shebang reads `#!/usr/bin/env sh\r` and the container dies
# with "exec format error" or "no such file or directory". Forcing LF in the
# repository makes that impossible regardless of who clones it.

* text=auto eol=lf

*.sh        text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.py        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.json      text eol=lf
*.md        text eol=lf

# Windows-only files keep CRLF.
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary: never touch.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.pdf       binary
*.db        binary
*.ipynb     text eol=lf
