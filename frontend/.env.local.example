# Copy to .env.local (git-ignored). No secrets belong here - this value is
# baked into the browser bundle, so it must be a public URL only.
#
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:8000
#
# After deploying the backend to Render, set this in the Vercel project settings
# (Settings -> Environment Variables) to your live API, e.g.:
# NEXT_PUBLIC_API_URL=https://multi-agent-analyst-api.onrender.com
