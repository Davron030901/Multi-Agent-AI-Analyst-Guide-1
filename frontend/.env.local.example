# Copy to .env.local (git-ignored).
#
# The console runs fully without a backend: with no API URL set, or when the
# backend is unreachable, it falls back to the recorded mock run so every
# screen and state stays demoable.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Force the mock stream even when a backend is reachable. Useful for design
# work and for recording the landing-page replay.
# NEXT_PUBLIC_FORCE_MOCK=true
